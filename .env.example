# ==============================================================================
# Pack-Assist AI - Environment Configuration Template
# Duplicate this file to .env and configure values for your environment.
# ==============================================================================

# Core Application Settings
PORT=8080
NODE_ENV=production
APP_URL=https://your-domain.com

# Database Connection (MongoDB Atlas or Self-Hosted Replica Set)
# Example Atlas URI: mongodb+srv://<db_user>:<db_pass>@cluster0.mongodb.net/pack-assist-ai?retryWrites=true&w=majority&appName=PackAssist
MONGODB_URI=mongodb://localhost:27017/pack-assist-ai
MONGODB_MAX_POOL_SIZE=20

# Cryptographic Session Security (Generate with: openssl rand -base64 48)
SESSION_SECRET=change_me_to_a_secure_random_production_secret_key_889900

# JSON Web Token (JWT) Security for API v1 Access
JWT_SECRET=change_me_to_a_secure_random_jwt_secret_token_112233
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins or *
CORS_ORIGIN=*

# Machine Learning Engine Configuration
# Options:
# - USE_PYTHON_DIRECT=true: Spawns local Python process (ideal for single-node / containerized setups)
# - ML_SERVICE_URL: URL to an external FastAPI / Uvicorn cluster (ideal for microservice architectures)
USE_PYTHON_DIRECT=true
ML_SERVICE_URL=http://127.0.0.1:5000
