<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="min-h-[calc(100vh-16rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 text-center">
  <div class="max-w-md w-full space-y-4 bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <div class="w-16 h-16 mx-auto rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-3xl">
      <i class="bi bi-exclamation-octagon"></i>
    </div>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">System Error</h1>
    <p class="text-xs text-slate-500">An unexpected exception occurred during packaging analysis computation.</p>
    <% if (typeof error !== 'undefined' && error && error.message) { %>
      <div class="p-3 bg-slate-50 rounded-xl text-[11px] font-mono text-rose-700 text-left overflow-x-auto">
        <%= error.message %>
      </div>
    <% } %>
    <div class="pt-2">
      <a href="/dashboard" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold transition text-decoration-none">
        Return to Dashboard
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
