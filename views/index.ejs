<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<!-- HERO BANNER SECTION (MATCHING REFERENCE DESIGN) -->
<section class="relative overflow-hidden bg-slate-950 text-white min-h-[660px] lg:min-h-[740px] flex items-center">
  
  <!-- BACKGROUND IMAGE WITH CINEMATIC LIGHTING & GRADIENTS -->
  <div class="absolute inset-0 z-0">
    <img src="/images/hero-bg.jpg" alt="Pack-Assist AI Intelligent Food Packaging Laboratory"
      class="w-full h-full object-cover object-center lg:object-right filter brightness-95" />
    
    <!-- Deep Gradient from Left to Right (Flawless Typography Legibility on Left, Image Details on Right) -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 sm:via-slate-950/80 to-slate-950/20"></div>
    <!-- Soft Top/Bottom Vignettes -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-transparent to-slate-950/80"></div>
  </div>

  <!-- FOREGROUND HERO CONTENT -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Primary Copy & CTAs (like reference image) -->
      <div class="lg:col-span-8 xl:col-span-7 space-y-6 text-left">
        
        <!-- Category Overline / Tag -->
        <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-widest text-sky-400 uppercase">
          <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
          <span>AI-POWERED FOOD PACKAGING INTELLIGENCE</span>
        </div>

        <!-- Hero Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          AI Based Food Material <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-sky-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">Recommendation System</span>
        </h1>

        <!-- Subtitle Description (like reference image) -->
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
          Profile your food commodity. Evaluate moisture, lipids, and respiration kinetics. Predict precision polymer barrier requirements (<strong class="text-white">OTR &amp; WVTR</strong>), <strong class="text-white">MAP gas ratios</strong>, and circular end-of-life disposal streams with AI evidence-backed technical datasheets.
        </p>

        <!-- Action Buttons (styled like reference image: 'Inspector Login ->' & 'District Officer Login') -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <% if (user) { %>
            <a href="/recommend" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-white bg-sky-600 hover:bg-sky-500 shadow-lg shadow-sky-600/30 transition text-decoration-none">
              <i class="fa-solid fa-microchip me-2"></i> Launch Assessment <i class="fa-solid fa-arrow-right ms-2 text-xs"></i>
            </a>
            <a href="/dashboard" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 backdrop-blur-md shadow-sm transition text-decoration-none">
              <i class="fa-solid fa-table-columns me-2 text-slate-400"></i> My Dashboard
            </a>
          <% } else { %>
            <a href="/register" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-white bg-sky-600 hover:bg-sky-500 shadow-lg shadow-sky-600/30 transition text-decoration-none">
              Start Free Assessment <i class="fa-solid fa-arrow-right ms-2 text-xs"></i>
            </a>
            <a href="/login" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 backdrop-blur-md shadow-sm transition text-decoration-none">
              <i class="fa-solid fa-arrow-right-to-bracket me-2 text-slate-400"></i> Sign In to Account
            </a>
          <% } %>
          </div>

        <!-- Feature Badges Row Along Bottom (like reference image: 'Offline OCR', 'Rule-level verification', 'Evidence-backed reports') -->
        <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-6 text-xs font-medium text-slate-400">
          <div class="flex items-center space-x-2">
            <i class="fa-solid fa-shield-halved text-sky-400"></i>
            <span>ASTM D3985 &amp; F1249 Aligned</span>
          </div>
          <div class="flex items-center space-x-2">
            <i class="fa-solid fa-circle-check text-emerald-400"></i>
            <span>FDA 21 CFR 177 Validated</span>
          </div>
          <div class="flex items-center space-x-2">
            <i class="fa-solid fa-file-pdf text-indigo-400"></i>
            <span>Evidence-Backed PDF Datasheets</span>
          </div>
          <div class="flex items-center space-x-2">
            <i class="fa-solid fa-recycle text-teal-400"></i>
            <span>Circular End-of-Life Scoring</span>
          </div>
        </div>

      </div>

      <!-- Right Area: Completely unobstructed, letting the background packaging & analytics tablet shine through -->

    </div>
  </div>

</section>

