<!-- THE CHALLENGE & OUR MISSION -->
<section class="py-16 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div class="space-y-6">
        <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-rose-600">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>The Global Problem</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-snug">
          1.3 Billion Tonnes of Food Wasted Annually Due to Suboptimal Barrier Protection
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Traditional food packaging qualification takes months of empirical lab shelf-life testing. Brand managers and R&amp;D teams often either <strong>over-package</strong> with costly, non-recyclable multi-layer foil laminates or <strong>under-package</strong>, causing rapid moisture migration, lipid rancidity, and microbial proliferation.
        </p>
        <p class="text-sm text-slate-600 leading-relaxed">
          At the same time, single-use plastic regulations and extended producer responsibility (EPR) mandates require rapid transition to circular mono-materials and industrially compostable bio-polymers without sacrificing product freshness.
        </p>
      </div>

      <div class="bg-gradient-to-br from-slate-900 to-slate-950 p-8 sm:p-10 rounded-3xl text-white shadow-xl border border-slate-800">
        <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-emerald-400 mb-4">
          <i class="fa-solid fa-bullseye"></i>
          <span>Our Core Mission</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-4">
          Autonomous Packaging Intelligence at Your Fingertips
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
          Pack-Assist AI bridges computational machine learning and food polymer physics. By ingesting commodity physical properties (moisture, lipids, pH, respiration rate) and logistics conditions, the system predicts:
        </p>
        <div class="space-y-3 text-xs sm:text-sm text-slate-200">
          <div class="flex items-start space-x-3">
            <i class="fa-solid fa-circle-check text-emerald-400 mt-1 shrink-0"></i>
            <span>Exact Oxygen Transmission Rate (<strong>OTR</strong>) &amp; Water Vapor Transmission Rate (<strong>WVTR</strong>) barrier thresholds.</span>
          </div>
          <div class="flex items-start space-x-3">
            <i class="fa-solid fa-circle-check text-emerald-400 mt-1 shrink-0"></i>
            <span>Optimized <strong>MAP Gas Headspace</strong> (`% CO₂`, `% O₂`, `% N₂`) calibrated for respiratory suppression.</span>
          </div>
          <div class="flex items-start space-x-3">
            <i class="fa-solid fa-circle-check text-emerald-400 mt-1 shrink-0"></i>
            <span>Biochemical <strong>Food-Packaging Compatibility Scoring</strong> to prevent flavor scalping and seal failure.</span>
          </div>
          <div class="flex items-start space-x-3">
            <i class="fa-solid fa-circle-check text-emerald-400 mt-1 shrink-0"></i>
            <span><strong>Smart Circular Disposal Stream</strong> classification (curbside mono-PE recycling vs. certified industrial composting).</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SCIENTIFIC PILLARS -->
<section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-bold uppercase tracking-wider text-sky-600 mb-2">Scientific Foundations</h2>
      <h3 class="text-3xl font-extrabold text-slate-900">How Pack-Assist AI Works Under the Hood</h3>
      <p class="text-sm text-slate-500 mt-2">
        Our multi-objective architecture combines machine learning models trained on food degradation kinetics with rigorous international testing standards.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: ML Model -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-microchip"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">Random Forest AI Engine</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Trained Scikit-Learn ensemble pipeline modeling complex non-linear degradation kinetics across moisture, lipid oxidation, acidity, and product respiratory behavior.
        </p>
      </div>

      <!-- Card 2: ASTM Standards -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">ASTM D3985 &amp; F1249</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Standardized coulometric and infrared sensor metrics calculating permeation rates in cc/m²/24h (OTR) and g/m²/24h (WVTR) to prevent sensory staling.
        </p>
      </div>

      <!-- Card 3: MAP Headspace -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-wind"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">Modified Atmosphere (MAP)</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Headspace gas formulation balancing antimicrobial CO₂ concentrations with O₂ suppression to inhibit aerobic microbial flora while preventing anaerobic off-odors.
        </p>
      </div>

      <!-- Card 4: Compatibility Score -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-flask"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">Food-Packaging Compatibility</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Evaluates moisture match, oxygen match, chemical inertness, and acid-lipid tolerance between product biochemistry and polymer contact surfaces.
        </p>
      </div>

      <!-- Card 5: Circular Disposal -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-recycle"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">Smart Disposable Packaging</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Recommends optimal end-of-life streams: certified industrial composting (EN 13432 / ASTM D6400), mono-PE mechanical recycling, or clean energy recovery.
        </p>
      </div>

      <!-- Card 6: PDF Datasheet -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-file-pdf"></i>
        </div>
        <h4 class="text-base font-bold text-slate-900 mb-2">Automated ISO Datasheets</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Generates ready-to-share industrial technical datasheets streamed dynamically via PDFKit, complete with polymer structure diagrams, ROI payback, and ASTM standards.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- STEP-BY-STEP PROCESS -->
<section class="py-16 bg-white border-b border-slate-200">
