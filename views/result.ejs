<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  
  <!-- Breadcrumb & Top Action Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center space-x-2 text-xs text-slate-500">
      <a href="/dashboard" class="hover:text-sky-600 text-decoration-none">Dashboard</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate max-w-xs"><%= rec.commodityName %></span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <!-- "Why is this material best?" Modal Trigger -->
      <button type="button" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition" data-bs-toggle="modal" data-bs-target="#explainerModal">
        <i class="bi bi-magic me-1.5"></i> Why is this material best?
      </button>

      <!-- Download PDF Report -->
      <a href="/recommend/<%= rec._id %>/pdf" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 shadow-sm transition text-decoration-none">
        <i class="bi bi-file-earmark-arrow-down-fill me-1.5"></i> Download PDF Report
      </a>

      <!-- Copy Specs Button -->
      <button type="button" id="copySpecsBtn"
        class="inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 transition">
        <i class="bi bi-clipboard me-1.5"></i> Copy Specs
      </button>

      <!-- Re-evaluate -->
      <a href="/recommend" class="inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 transition text-decoration-none">
        <i class="bi bi-arrow-repeat me-1.5"></i> New Assessment
      </a>
    </div>
  </div>

  <!-- HERO RESULT CARD: OPTIMAL MATERIAL -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-sky-950 text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Material Announcement -->
      <div class="lg:col-span-8 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            <i class="bi bi-shield-check me-1"></i> AI Optimal Material Selection
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/30">
            <%= rec.commodityType %>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white leading-tight">
          <%= rec.recommendation.recommendedMaterial %>
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-300">
          <div><strong class="text-white">Polymer Class:</strong> <%= rec.recommendation.polymerType %></div>
          <span>&bull;</span>
          <div><strong class="text-white">Resin Code:</strong> <%= rec.recommendation.recyclingCode %></div>
          <span>&bull;</span>
          <div><strong class="text-white">Target Shelf Life:</strong> <%= (rec.inputs && rec.inputs.desiredShelfLifeDays) || 30 %> Days</div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 max-w-3xl leading-relaxed pt-2 border-t border-slate-700/60">
          <%= rec.recommendation.chemistryBreakdown.barrierMechanics %>
        </p>
      </div>

      <!-- Suitability & Carbon Score Badges -->
      <div class="lg:col-span-4 flex flex-row lg:flex-col gap-4 justify-between lg:justify-center lg:items-end">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 text-center w-full max-w-[200px]">
          <div class="text-[10px] text-slate-300 uppercase font-bold tracking-wider">Suitability Match</div>
          <div class="text-3xl font-black text-emerald-400 mt-1"><%= rec.recommendation.suitabilityScore %>%</div>
          <div class="text-[10px] text-emerald-200 mt-0.5">Optimal Barrier Fit</div>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 text-center w-full max-w-[200px]">
          <div class="text-[10px] text-slate-300 uppercase font-bold tracking-wider">Carbon Savings</div>
          <div class="text-3xl font-black text-sky-300 mt-1">+<%= rec.recommendation.carbonSavingsPct %>%</div>
          <div class="text-[10px] text-sky-200 mt-0.5">vs Standard Packaging</div>
        </div>
      </div>

    </div>
  </div>

  <!-- SPECS GRID: BARRIER TRANSMISSION & MAP GAS RATIOS -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- OTR Box -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 card-hover">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Oxygen Permeance</span>
        <span class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center text-xs font-bold">OTR</span>
      </div>
      <div class="text-2xl font-black text-slate-900">
        <%= rec.recommendation.barrierRequirements.otr %>
        <span class="text-xs font-normal text-slate-500">cc/m²/24h</span>
      </div>
      <p class="text-[11px] text-slate-500">ASTM D3985 / 1 atm @ 23°C</p>
    </div>

    <!-- WVTR Box -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 card-hover">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Vapor Ingress</span>
        <span class="w-7 h-7 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center text-xs font-bold">WVTR</span>
      </div>
      <div class="text-2xl font-black text-slate-900">
        <%= rec.recommendation.barrierRequirements.wvtr %>
        <span class="text-xs font-normal text-slate-500">g/m²/24h</span>
      </div>
      <p class="text-[11px] text-slate-500">ASTM F1249 / 90% RH @ 38°C</p>
    </div>

    <!-- Film Thickness Box -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 card-hover">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Film Caliper / Gauge</span>
        <span class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-bold">µm</span>
      </div>
      <div class="text-2xl font-black text-slate-900">
        <%= rec.recommendation.structuralSpecs.recommendedThicknessMicrons %>
        <span class="text-xs font-normal text-slate-500">Microns</span>
      </div>
      <p class="text-[11px] text-slate-500">Tensile: <%= rec.recommendation.structuralSpecs.tensileStrengthMpa %> MPa</p>
    </div>

    <!-- MAP Headspace Box -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 card-hover">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">MAP Gas Balance</span>
        <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs"><i class="bi bi-wind"></i></span>
      </div>
      <div class="text-lg font-black text-slate-900">
        <%= rec.recommendation.mapGasRatios.co2Pct %>% CO₂ &bull; <%= rec.recommendation.mapGasRatios.o2Pct %>% O₂
      </div>
      <p class="text-[11px] text-slate-500">Balance: <%= rec.recommendation.mapGasRatios.n2Pct %>% N₂ Flush</p>
    </div>

  </div>

  <!-- INTERACTIVE CHARTS (CHART.JS) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Chart 1: Trade-offs Radar / Multi-axis Comparison -->
    <div class="lg:col-span-8 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h2 class="text-base font-bold text-slate-900">Trade-Off Analysis: Material Alternatives</h2>
          <p class="text-xs text-slate-500">Mapping Shelf-Life Score vs. Relative Cost vs. Carbon Footprint Index</p>
        </div>
        <span class="text-[11px] font-semibold text-sky-600 px-2 py-1 bg-sky-50 rounded-lg">Multi-Criteria Evaluation</span>
      </div>
      
      <div class="h-80 w-full relative">
        <canvas id="tradeoffsChart"></canvas>
      </div>

      <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between text-xs text-slate-500">
        <div>* Lower Cost Index and lower Carbon Index indicate superior economic and ecological viability.</div>
        <div class="font-bold text-emerald-600"><%= rec.recommendation.recommendedMaterial %> ranks highest overall</div>
      </div>
    </div>

    <!-- Chart 2: MAP Gas Atmosphere Ratio Doughnut -->
    <div class="lg:col-span-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 flex flex-col justify-between">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-base font-bold text-slate-900">Modified Atmosphere (MAP) Mix</h2>
        <p class="text-xs text-slate-500">Recommended package headspace gas distribution</p>
      </div>

      <div class="h-64 w-full relative flex items-center justify-center">
        <canvas id="mapGasChart"></canvas>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center text-xs pt-3 border-t border-slate-100">
        <div class="p-2 rounded-lg bg-rose-50">
          <div class="text-[10px] font-bold text-rose-700">CO₂ (Inhibitor)</div>
          <div class="font-extrabold text-slate-800"><%= rec.recommendation.mapGasRatios.co2Pct %>%</div>
        </div>
        <div class="p-2 rounded-lg bg-sky-50">
          <div class="text-[10px] font-bold text-sky-700">O₂ (Color/Resp)</div>
          <div class="font-extrabold text-slate-800"><%= rec.recommendation.mapGasRatios.o2Pct %>%</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-100">
          <div class="text-[10px] font-bold text-slate-600">N₂ (Filler)</div>
          <div class="font-extrabold text-slate-800"><%= rec.recommendation.mapGasRatios.n2Pct %>%</div>
        </div>
      </div>
    </div>

  </div>

  <!-- SECTION: FOOD-PACKAGING COMPATIBILITY SCORE -->
  <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-sm space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-sky-100 text-sky-800 uppercase tracking-wider">
            AI Multi-Property Scoring
          </span>
          <span class="text-xs font-semibold text-slate-400">&bull; ISO / ASTM Standards</span>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Food-Packaging Compatibility Score</h3>
        <p class="text-xs text-slate-500">Holistic synergy calculation between food biochemical profile and polymer barrier matrix</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm">
          <i class="fa-solid fa-circle-check me-1.5 text-emerald-500"></i>
          <%= (rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.rating) || 'Optimal Synergistic Compatibility' %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Left Column: Circular Gauge & Diagnostic Verdict -->
      <div class="lg:col-span-4 p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-sky-950 text-white flex flex-col items-center text-center justify-center space-y-3 relative overflow-hidden">
        <div class="relative w-32 h-32 flex items-center justify-center">
          <!-- Circular Ring background -->
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
            <path class="text-slate-800" stroke-width="3" stroke="currentColor" fill="none"
              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <path id="compatGaugeCircle" class="text-emerald-400 transition-all duration-1000 ease-out" data-dasharray="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.overall) || 95.8) %>" stroke-dasharray="95.8, 100" stroke-width="3" stroke-linecap="round" stroke="currentColor" fill="none"
              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <div class="absolute flex flex-col items-center">
            <span class="text-3xl font-black text-white"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.overall) || 95.8) %>%</span>
            <span class="text-[9px] uppercase tracking-wider text-emerald-300 font-bold">Compatibility</span>
          </div>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-bold text-white"><%= rec.commodityName %> &bull; <%= rec.recommendation.recommendedMaterial %></div>
          <p class="text-[11px] text-slate-300 leading-relaxed px-2">
            <%= (rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.summary) || 'Polymer structure exhibits exceptional biochemical alignment with target moisture, lipid content, and respiration kinetics.' %>
          </p>
        </div>
      </div>

      <!-- Right Column: Multi-Property Breakdown Bars -->
      <div class="lg:col-span-8 space-y-3.5">
        
        <!-- Property 1: Moisture Alignment -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-droplet text-sky-500 w-4"></i> Moisture Barrier Alignment (WVTR)
            </span>
            <span class="font-bold text-slate-900"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.moistureMatch) || 97) %>%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-sky-500 h-2 rounded-full transition-all duration-700 ease-out" data-progress="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.moistureMatch) || 97) %>"></div>
          </div>
        </div>

        <!-- Property 2: Oxygen Sensitivity Match -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-wind text-indigo-500 w-4"></i> Oxygen Sensitivity &amp; Gas Balance (OTR)
            </span>
            <span class="font-bold text-slate-900"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.oxygenMatch) || 95) %>%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-indigo-500 h-2 rounded-full transition-all duration-700 ease-out" data-progress="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.oxygenMatch) || 95) %>"></div>
          </div>
        </div>

        <!-- Property 3: Chemical & Acid/Lipid Inertness -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-flask text-teal-500 w-4"></i> Chemical Inertness &amp; Non-Migration
            </span>
            <span class="font-bold text-slate-900"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.chemicalInertness) || 96) %>%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-teal-500 h-2 rounded-full transition-all duration-700 ease-out" data-progress="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.chemicalInertness) || 96) %>"></div>
          </div>
        </div>

        <!-- Property 4: Thermal & Mechanical Resilience -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-temperature-arrow-up text-amber-500 w-4"></i> Thermal &amp; Mechanical Handling Resilience
            </span>
            <span class="font-bold text-slate-900"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.thermalMechanical) || 94) %>%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-amber-500 h-2 rounded-full transition-all duration-700 ease-out" data-progress="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.thermalMechanical) || 94) %>"></div>
          </div>
        </div>

        <!-- Property 5: Acid/pH & Lipid Tolerance -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-shield-virus text-emerald-500 w-4"></i> Acid (pH <%= (rec.inputs && rec.inputs.ph) || 7 %>) &amp; Lipid (<%= (rec.inputs && rec.inputs.fatContent) || 0 %>%) Defense
            </span>
            <span class="font-bold text-slate-900"><%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.acidLipidTolerance) || 97) %>%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div class="bg-emerald-500 h-2 rounded-full transition-all duration-700 ease-out" data-progress="<%= ((rec.recommendation.compatibilityScore && rec.recommendation.compatibilityScore.acidLipidTolerance) || 97) %>"></div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION: SMART DISPOSABLE PACKAGING -->
  <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-sm space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase tracking-wider">
            Smart End-of-Life Recommendation
          </span>
          <span class="text-xs font-semibold text-slate-400">&bull; Circular Economy Framework</span>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Smart Disposable Packaging</h3>
        <p class="text-xs text-slate-500">Materials and disposal stream calibrated for Safety, Protection, Cost, and Sustainability</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-sm">
          <i class="fa-solid fa-recycle me-1.5"></i> <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.wasteStream) || 'Curbside Recyclable Stream' %>
        </span>
      </div>
    </div>

    <!-- Recommended Disposal Stream Banner -->
    <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-sky-50 border border-emerald-200/80 space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-sm shadow-md shadow-emerald-600/25 shrink-0">
            <i class="fa-solid fa-dumpster"></i>
          </div>
          <div>
            <span class="text-[10px] text-emerald-800 font-bold uppercase tracking-wider block">Recommended Disposal Pathway</span>
            <span class="text-sm font-extrabold text-slate-900"><%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.recommendedMethod) || 'Curbside Closed-Loop Polyolefin Re-granulation' %></span>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-white text-emerald-800 border border-emerald-200">
          <i class="fa-solid fa-trash-can-arrow-up me-1 text-emerald-600"></i> <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.wasteStream) || 'Household Plastics Bin' %>
        </span>
      </div>

      <p class="text-xs text-slate-700 leading-relaxed pt-1 border-t border-emerald-200/60">
        <strong class="text-emerald-900">Sorting &amp; Handling:</strong> <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.disposalInstructions) || 'Rinse or wipe residual food particles before placing in designated recovery container.' %>
      </p>

      <div class="text-[11px] text-slate-600 flex items-center gap-1.5">
        <i class="fa-solid fa-seedling text-emerald-600"></i>
        <span><strong>Ecological Impact:</strong> <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.environmentalImpact) || 'Diverts packaging from landfill and lowers upstream carbon emissions.' %></span>
      </div>
    </div>

    <!-- The 4 User-Requested Evaluation Pillars: Safety, Protection, Cost, Sustainability -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Pillar 1: Safety -->
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1.5 card-hover">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700">1. Safety</span>
          <i class="fa-solid fa-shield-halved text-emerald-500 text-xs"></i>
        </div>
        <div class="text-xl font-black text-slate-900">
          <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.safetyScore) || 96 %><span class="text-xs font-normal text-slate-400">/100</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
          <div class="bg-emerald-500 h-1.5 rounded-full transition-all duration-700 ease-out" data-progress="<%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.safetyScore) || 96 %>"></div>
        </div>
        <p class="text-[10px] text-slate-500 leading-tight pt-1">
          Zero hazardous additive leaching, no harmful PFAS, non-toxic organic degradation.
        </p>
      </div>

      <!-- Pillar 2: Protection -->
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1.5 card-hover">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-sky-700">2. Protection</span>
          <i class="fa-solid fa-box text-sky-500 text-xs"></i>
        </div>
        <div class="text-xl font-black text-slate-900">
          <%= (rec.recommendation.smartDisposable && rec.recommendation.smartDisposable.protectionScore) || 95 %><span class="text-xs font-normal text-slate-400">/100</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
