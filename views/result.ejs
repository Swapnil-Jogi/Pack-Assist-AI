          <div class="flex items-center justify-between text-[10px] text-slate-500 pt-0.5">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span> Packaging Investment (<span id="pctPackagingShare">20%</span>)</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> Prevented Food Waste Value Retained (<span id="pctSavingsShare">80%</span>)</span>
          </div>
        </div>

        <!-- Commercial Payback Verdict & Ecological Dividend Banner -->
        <div class="p-4 rounded-xl bg-gradient-to-r from-sky-50 via-indigo-50 to-emerald-50 border border-sky-200 space-y-2">
