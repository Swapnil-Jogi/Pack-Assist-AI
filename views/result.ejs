          <i class="fa-solid fa-scale-balanced text-slate-500 me-1"></i> Disposable Material Options Comparison
        </h4>
        <span class="text-[11px] text-slate-400">Comparative 4-Pillar Multi-Attribute Analysis</span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <th class="py-2.5 px-3">Disposable Packaging Option</th>
              <th class="py-2.5 px-3 text-center">Safety</th>
              <th class="py-2.5 px-3 text-center">Protection</th>
              <th class="py-2.5 px-3 text-center">Cost</th>
              <th class="py-2.5 px-3 text-center">Sustainability</th>
              <th class="py-2.5 px-3 text-right">Disposal Destination</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% disposableAlts.forEach((alt, idx) => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3 px-3 font-bold text-slate-800">
                  <%= alt.material %>
                  <% if (idx === 0) { %>
                    <span class="ms-1.5 px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800">Top Match</span>
                  <% } %>
                </td>
                <td class="py-3 px-3 text-center">
                  <span class="px-2 py-0.5 rounded-full font-bold text-[10px] bg-emerald-50 text-emerald-700"><%= alt.safety %>/100</span>
                </td>
                <td class="py-3 px-3 text-center">
                  <span class="px-2 py-0.5 rounded-full font-bold text-[10px] bg-sky-50 text-sky-700"><%= alt.protection %>/100</span>
                </td>
                <td class="py-3 px-3 text-center">
                  <span class="px-2 py-0.5 rounded-full font-bold text-[10px] bg-amber-50 text-amber-700"><%= alt.cost %>/100</span>
                </td>
                <td class="py-3 px-3 text-center">
                  <span class="px-2 py-0.5 rounded-full font-bold text-[10px] bg-teal-50 text-teal-700"><%= alt.sustainability %>/100</span>
                </td>
                <td class="py-3 px-3 text-right text-slate-600 font-medium">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-[10px]"><%= alt.disposal %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- SECTION: PACKAGING ECONOMICS & ROI WASTE REDUCTION CALCULATOR -->
