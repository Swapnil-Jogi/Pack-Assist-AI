            </div>
            <p class="text-[10px] text-sky-800 leading-tight font-medium" id="kpiNetGain">
              ₹2,85,000 net bottom-line gain
            </p>
          </div>

        </div>

        <!-- Comparative Visual Breakdown Bar -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2.5">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-slate-700 flex items-center gap-1.5">
